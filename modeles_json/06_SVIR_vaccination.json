    {
      "state_id": "V_h",
      "label": "Vaccinated",
      "state_type": "susceptible",
      "species": "human",
      "dfe_expr": "Ntot * p_v",
      "dfe_auto": false,
      "dfe_comment": "V* = Ntot * proportion_vaccinee"
    },
    {
      "state_id": "I_h",
      "label": "Infectious",
      "state_type": "infectious",
      "species": "human",
      "dfe_expr": "0",
      "dfe_auto": true,
      "dfe_comment": "Infectieux nuls au DFE"
    },
    {
      "state_id": "R_h",
      "label": "Recovered",
      "state_type": "recovered",
      "species": "human",
      "dfe_expr": "0",
      "dfe_auto": true,
      "dfe_comment": "Remis nuls au DFE"
    }
  ],
  "params": [
    {
      "param_name": "beta_c",
      "description": "Taux de transmission de contact",
      "units": "1/jour",
      "category": "flux_only",
      "in_flux": true, "in_dfe": false
    },
    {
      "param_name": "gamma_r",
      "description": "Taux de guerison",
      "units": "1/jour",
      "category": "flux_only",
      "in_flux": true, "in_dfe": false
    },
    {
      "param_name": "nu_v",
      "description": "Taux de vaccination",
      "units": "1/jour",
      "category": "flux_only",
      "in_flux": true, "in_dfe": false
