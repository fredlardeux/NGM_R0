      "rate_template_id": "", "rate_template_label": "",
      "rate_expression_auto": "", "rate_source": "manual",
      "rate_validated": true,
      "rate_units": "1/jour",
      "rate_comment": "Taux de guerison asymptomatiques",
      "rate_param_desc": ""
