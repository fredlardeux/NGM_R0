      "strain": "", "age_class": "", "patch": "",
      "description": "Individus susceptibles",
      "verification": "ok"
    },
    {
      "state_id": "E_h",
      "label": "Exposed",
      "state_type": "exposed",
      "state_comment": "En periode d incubation",
