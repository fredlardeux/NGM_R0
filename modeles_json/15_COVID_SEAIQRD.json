    {
      "state_id": "Q_h",
      "label": "Quarantined",
      "state_type": "infectious",
      "state_comment": "En quarantaine/isolement",
      "species": "human",
      "strain": "", "age_class": "", "patch": "",
      "description": "Cas isoles - contribution reduite a la transmission",
      "verification": "ok"
    },
    {
      "state_id": "R_h",
      "label": "Recovered",
      "state_type": "recovered",
      "state_comment": "Gueris immunises",
      "species": "human",
      "strain": "", "age_class": "", "patch": "",
      "description": "Population guerie",
      "verification": "ok"
    },
    {
      "state_id": "D_h",
      "label": "Dead",
      "state_type": "dead",
      "state_comment": "Deces lies au COVID",
      "species": "human",
      "strain": "", "age_class": "", "patch": "",
      "description": "Deces COVID - hors NGM",
      "verification": "ok"
    }
  ],
  "fluxes": [
    {
      "flux_id": "F1",
      "from_state_id": "S_h",
      "to_state_id": "E_h",
      "process_type": "transmission",
      "transmission_type": "direct",
      "density_type": "frequency",
      "rate_name": "beta_c",
      "rate_expression": "beta_c * S_h * (I_h + rho_a * A_h + rho_q * Q_h) / Ntot",
      "description": "Transmission par I, A et Q (reduit)",
      "is_demographic": false, "is_progression": false, "is_recovery": false,
      "verification": "ok",
      "rate_template_id": "", "rate_template_label": "",
      "rate_expression_auto": "", "rate_source": "manual",
      "rate_validated": true,
      "rate_units": "1/jour",
      "rate_comment": "rho_a<1: transmissibilite asymptomatiques; rho_q<<1: quarantaine",
      "rate_param_desc": ""
    },
    {
      "flux_id": "F2",
      "from_state_id": "E_h",
      "to_state_id": "A_h",
      "process_type": "progression",
      "transmission_type": "", "density_type": "",
      "rate_name": "sigma_e",
      "rate_expression": "p_a * sigma_e * E_h",
      "description": "Progression vers asymptomatiques",
      "is_demographic": false, "is_progression": true, "is_recovery": false,
      "verification": "ok",
      "rate_template_id": "", "rate_template_label": "",
      "rate_expression_auto": "", "rate_source": "manual",
      "rate_validated": true,
      "rate_units": "1/jour",
      "rate_comment": "p_a = proportion asymptomatique",
      "rate_param_desc": ""
    },
    {
      "flux_id": "F3",
      "from_state_id": "E_h",
      "to_state_id": "I_h",
      "process_type": "progression",
      "transmission_type": "", "density_type": "",
      "rate_name": "sigma_e",
      "rate_expression": "(1 - p_a) * sigma_e * E_h",
      "description": "Progression vers symptomatiques",
      "is_demographic": false, "is_progression": true, "is_recovery": false,
      "verification": "ok",
      "rate_template_id": "", "rate_template_label": "",
      "rate_expression_auto": "", "rate_source": "manual",
      "rate_validated": true,
      "rate_units": "1/jour",
      "rate_comment": "(1-p_a) = proportion symptomatique",
      "rate_param_desc": ""
